# ============================================
# TEGL Retail Frontend - Environment Variables
# ============================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to git (it's already in .gitignore).

# --- Clerk Authentication (Customer Portal) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...your_clerk_publishable_key...

# --- Google OAuth (Admin Login via Google Sign-In) ---
VITE_GOOGLE_CLIENT_ID=...your_google_client_id...

# --- Supabase (Optional: if using Supabase JS client directly) ---
# These are only needed if frontend code directly calls Supabase.
# The main backend (Flask on Render) already handles DB access.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Backend API URL (for local development proxy override) ---
# In production, Vercel's vercel.json rewrites /api/* to the Render backend.
# Only set this locally if you want to override the proxy target.
# VITE_API_BASE_URL=http://localhost:5000
