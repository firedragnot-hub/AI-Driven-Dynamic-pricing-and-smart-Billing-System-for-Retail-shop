{
  "version": 2,
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/app.py"
    },
    {
      "src": "/((?!api/).*\\..*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "/frontend/index.html"
    }
  ]
}
